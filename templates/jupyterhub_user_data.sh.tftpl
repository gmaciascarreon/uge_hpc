#!/bin/bash
set -exo pipefail

SGE_ROOT=/opt/ocs
export HOME=/root

# --- Hostname resolution (Grid Engine needs consistent names on every node) ---
hostnamectl set-hostname jupyter
echo "preserve_hostname: true" > /etc/cloud/cloud.cfg.d/99-preserve-hostname.cfg
cat >> /etc/hosts <<'HOSTS'
${hosts_entries}
HOSTS

dnf install -y nfs-utils libtirpc tar which hostname git gcc \
  python3.11 python3.11-pip nodejs npm socat

# --- Mount SGE_ROOT, /home and /opt/apps from the master (retry until exported) ---
mkdir -p $SGE_ROOT /opt/apps
cat >> /etc/fstab <<FSTAB
master:$SGE_ROOT $SGE_ROOT nfs defaults,_netdev,nofail 0 0
master:/home /home nfs defaults,_netdev,nofail 0 0
master:/opt/apps /opt/apps nfs defaults,_netdev,nofail 0 0
FSTAB
systemctl daemon-reload

until mountpoint -q $SGE_ROOT; do mount $SGE_ROOT || sleep 15; done
until mountpoint -q /home; do mount /home || sleep 15; done
until mountpoint -q /opt/apps; do mount /opt/apps || sleep 15; done

# Grid Engine client environment (this host is a submit host)
echo ". $SGE_ROOT/default/common/settings.sh" > /etc/profile.d/ocs.sh

# --- JupyterHub login: PAM as ec2-user ---
set +x # keep the password out of the cloud-init log
echo 'ec2-user:${password}' | chpasswd
set -x

# --- JupyterHub + JupyterLab + VS Code (code-server) ---
# The Hub and its proxy run here; the user servers run as Grid Engine jobs on
# the workers, so the Python environment and code-server are installed on the
# NFS share /opt/apps where every node can use them.
npm install -g configurable-http-proxy

python3.11 -m venv /opt/apps/jupyter
/opt/apps/jupyter/bin/pip install --upgrade pip
/opt/apps/jupyter/bin/pip install jupyterhub jupyterlab notebook \
  jupyter-server-proxy jupyter-vscode-proxy

curl -fsSL https://code-server.dev/install.sh | sh -s -- --method=standalone --prefix=/opt/apps/code-server

mkdir -p /etc/jupyterhub/ssl
cat > /etc/jupyterhub/ssl/cert.pem <<'CERT'
${tls_cert}
CERT
cat > /etc/jupyterhub/ssl/key.pem <<'KEY'
${tls_key}
KEY
chmod 600 /etc/jupyterhub/ssl/key.pem

cat > /etc/jupyterhub/jupyterhub_config.py <<'CONFIG'
${jupyterhub_config}
CONFIG

cat > /etc/systemd/system/jupyterhub.service <<'UNIT'
[Unit]
Description=JupyterHub
After=network-online.target remote-fs.target
Wants=network-online.target
RequiresMountsFor=/home /opt/ocs /opt/apps

[Service]
User=root
WorkingDirectory=/etc/jupyterhub
Environment=PATH=/opt/apps/jupyter/bin:/usr/local/bin:/opt/ocs/bin/lx-amd64:/usr/bin:/bin:/usr/sbin:/sbin
Environment=JUPYTERHUB_PUBLIC_IP=${public_ip}
Environment=VSCODE_MAX_SESSIONS=${max_sessions}
ExecStart=/opt/apps/jupyter/bin/jupyterhub -f /etc/jupyterhub/jupyterhub_config.py
Restart=on-failure

[Install]
WantedBy=multi-user.target
UNIT

# --- VS Code Remote gateway: public port 2200+N -> the worker running session N ---
cat > /usr/local/bin/vscode-gw <<'GW'
#!/bin/bash
exec socat TCP-LISTEN:$((2200 + $1)),fork,reuseaddr EXEC:"/opt/apps/vscode-remote/connect.sh $1"
GW
chmod 755 /usr/local/bin/vscode-gw

cat > /etc/systemd/system/vscode-gw@.service <<'UNIT'
[Unit]
Description=VS Code Remote gateway for session %i
After=network-online.target remote-fs.target
RequiresMountsFor=/opt/apps

[Service]
User=nobody
ExecStart=/usr/local/bin/vscode-gw %i
Restart=always

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now jupyterhub
for n in $(seq 1 ${max_sessions}); do
  systemctl enable --now vscode-gw@$n
done
