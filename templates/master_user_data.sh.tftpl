#!/bin/bash
set -exo pipefail

SGE_ROOT=/opt/ocs
OCS_VERSION=${ocs_version}
OCS_URL=https://open.clusterscheduler.io/download/ocs-$OCS_VERSION
WORKERS="${worker_names}"

# --- Hostname resolution (Grid Engine needs consistent names on every node) ---
hostnamectl set-hostname master
echo "preserve_hostname: true" > /etc/cloud/cloud.cfg.d/99-preserve-hostname.cfg
cat >> /etc/hosts <<'HOSTS'
${hosts_entries}
HOSTS

dnf install -y nfs-utils libtirpc tar which hostname git gcc

# --- Passwordless SSH for ec2-user (home is NFS-shared with the workers) ---
mkdir -p /home/ec2-user/.ssh
cat > /home/ec2-user/.ssh/id_rsa <<'KEY'
${private_key}
KEY
echo "${public_key}" > /home/ec2-user/.ssh/id_rsa.pub
echo "${public_key}" >> /home/ec2-user/.ssh/authorized_keys
# Optional key of the user's local machine, for VS Code Remote sessions
VSCODE_KEY="${vscode_key}"
if [ -n "$VSCODE_KEY" ]; then
  echo "$VSCODE_KEY" >> /home/ec2-user/.ssh/authorized_keys
fi
cat > /home/ec2-user/.ssh/config <<'CFG'
Host master node*
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  LogLevel ERROR
CFG
chmod 700 /home/ec2-user/.ssh
chmod 600 /home/ec2-user/.ssh/id_rsa /home/ec2-user/.ssh/authorized_keys /home/ec2-user/.ssh/config
chown -R ec2-user:ec2-user /home/ec2-user/.ssh

# --- Download and unpack Open Cluster Scheduler (prebuilt binaries) ---
mkdir -p $SGE_ROOT /tmp/ocs_downloads
cd /tmp/ocs_downloads
for pkg in bin-lx-amd64 common doc; do
  curl -fsSL -o ocs-$OCS_VERSION-$pkg.tar.gz $OCS_URL/ocs-$OCS_VERSION-$pkg.tar.gz
  tar xpf ocs-$OCS_VERSION-$pkg.tar.gz -C $SGE_ROOT
done

# Accept kernels newer than 6.x in the arch detection script (same fix as the
# upstream quickinstall script).
sed -i 's/2\.4\.\*|2\.6\.\*|3\.\*|4\.\*|5\.\*|6\.\*)/2.4.*|2.6.*|[3-9].*)/' $SGE_ROOT/util/arch

# --- Autoinstall template (also read by the workers from the shared SGE_ROOT) ---
cat > $SGE_ROOT/autoinstall.template <<TEMPLATE
SGE_ROOT="$SGE_ROOT"
SGE_QMASTER_PORT="6444"
SGE_EXECD_PORT="6445"
SGE_ENABLE_SMF="false"
SGE_CLUSTER_NAME="p6444"
CELL_NAME="default"
ADMIN_USER="root"
QMASTER_SPOOL_DIR="$SGE_ROOT/default/spool/qmaster"
EXECD_SPOOL_DIR="$SGE_ROOT/default/spool"
GID_RANGE="20000-20200"
SPOOLING_METHOD="classic"
DB_SPOOLING_DIR="$SGE_ROOT/default/spool/bdb"
PAR_EXECD_INST_COUNT="20"
ADMIN_HOST_LIST="master $WORKERS"
SUBMIT_HOST_LIST="master jupyter $WORKERS"
EXEC_HOST_LIST="$WORKERS"
EXECD_SPOOL_DIR_LOCAL="/var/spool/ocs"
HOSTNAME_RESOLVING="true"
SHELL_NAME="ssh"
COPY_COMMAND="scp"
DEFAULT_DOMAIN="none"
ADMIN_MAIL="none"
ADD_TO_RC="true"
SET_FILE_PERMS="true"
RESCHEDULE_JOBS="wait"
SCHEDD_CONF="1"
SHADOW_HOST=""
EXEC_HOST_LIST_RM=""
REMOVE_RC="false"
CSP_RECREATE="true"
CSP_COPY_CERTS="false"
CSP_COUNTRY_CODE="US"
CSP_STATE="State"
CSP_LOCATION="Building"
CSP_ORGA="Organisation"
CSP_ORGA_UNIT="Organisation_unit"
CSP_MAIL_ADDRESS="none@example.com"
TEMPLATE

# --- Install qmaster only (execution daemons are installed by the workers) ---
# The installer writes rc scripts; recent distros no longer ship these dirs.
mkdir -p /etc/rc.d/rc3.d /etc/rc.d/init.d
cd $SGE_ROOT
export LD_LIBRARY_PATH=""
./inst_sge -m -auto $SGE_ROOT/autoinstall.template || true
test -f $SGE_ROOT/default/common/settings.sh

echo ". $SGE_ROOT/default/common/settings.sh" > /etc/profile.d/ocs.sh
. $SGE_ROOT/default/common/settings.sh

# --- Shared application scripts (/opt/apps) ---
mkdir -p /opt/apps/vscode-remote/slots
chmod 1777 /opt/apps/vscode-remote/slots
echo "${max_sessions}" > /opt/apps/vscode-remote/max_sessions
cat > /opt/apps/vscode-remote/session.sh <<'SESSION'
${session_sh}
SESSION
cat > /opt/apps/vscode-remote/connect.sh <<'CONNECT'
${connect_sh}
CONNECT
chmod 755 /opt/apps/vscode-remote/session.sh /opt/apps/vscode-remote/connect.sh
mkdir -p /opt/apps/jupyterhub
cat > /opt/apps/jupyterhub/job.sh <<'JOB'
${job_sh}
JOB
chmod 755 /opt/apps/jupyterhub/job.sh
install -d -o ec2-user -g ec2-user /home/ec2-user/vscode-remote

# --- Share SGE_ROOT, /home and /opt/apps with the other nodes ---
# Exported as soon as qmaster is installed and before the optional
# configuration below, so a configuration problem can never leave the other
# nodes without their shares. Workers still wait until qmaster answers
# (qconf -sh) before installing execd.
cat > /etc/exports <<EXPORTS
$SGE_ROOT ${subnet_cidr}(rw,sync,no_root_squash,no_subtree_check)
/home ${subnet_cidr}(rw,sync,no_root_squash,no_subtree_check)
/opt/apps ${subnet_cidr}(rw,sync,no_root_squash,no_subtree_check)
EXPORTS
systemctl enable --now nfs-server
exportfs -ra

# --- Grid Engine configuration ---
# qconf's exit codes are unreliable for changes (OCS 9.1.6 "qconf -Ace" exits 1
# on success), so each change is run without set -e and then verified.
qconf -am ec2-user || true
qconf -sm | grep -qx ec2-user

# Global consumable limiting concurrent VS Code sessions: each VS Code job
# requests -l vscode=1.
cat > /tmp/vscode.centry <<'CENTRY'
name        vscode
shortcut    vscode
type        INT
relop       <=
requestable YES
consumable  YES
default     0
urgency     0
CENTRY
qconf -Ace /tmp/vscode.centry || true
qconf -sc | grep -q '^vscode '
qconf -mattr exechost complex_values vscode=${max_sessions} global || true
qconf -se global | grep -q 'vscode=${max_sessions}'

# Queue for JupyterHub sessions (JupyterLab and VS Code jobs). Interactive
# sessions are mostly idle, so it has ${max_sessions} slots per worker on top of
# all.q. The FORCED "interactive" complex keeps batch jobs out of it: only jobs
# requesting -l interactive=true (the Hub's) can run there.
cat > /tmp/interactive.centry <<'CENTRY'
name        interactive
shortcut    inter
type        BOOL
relop       ==
requestable FORCED
consumable  NO
default     FALSE
urgency     0
CENTRY
qconf -Ace /tmp/interactive.centry || true
qconf -sc | grep -q '^interactive '
qconf -sq all.q | sed \
  -e 's/^qname .*/qname                 interactive.q/' \
  -e 's/^slots .*/slots                 ${max_sessions}/' \
  -e 's/^complex_values .*/complex_values        interactive=TRUE/' \
  > /tmp/interactive.q
qconf -Aq /tmp/interactive.q || true
qconf -sql | grep -qx interactive.q
